# ============================================================
# .env.local.example
# 실제 사용 시 이 파일을 .env.local 로 복사 후 키 값 입력
# ⚠️  .env.local 은 절대 Git 커밋 금지 (.gitignore 확인)
# ⚠️  NEXT_PUBLIC_ 접두사 없는 변수만 사용 (클라이언트 번들 노출 방지)
# ============================================================

# ────────────────────────────────────────────────────────────
# 주식 데이터 — Yahoo Finance (via RapidAPI)
# 용도: 실시간(지연) 시세, 종목 검색, OHLCV, 시장 지수
# 무료 한도: 500회/월
# 발급: https://rapidapi.com/apidojo/api/yahoo-finance1
# ────────────────────────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=yahoo-finance15.p.rapidapi.com

# ────────────────────────────────────────────────────────────
# 기술적 지표 — Alpha Vantage
# 용도: RSI, MACD, 이동평균선 (계산값 직접 제공)
# 무료 한도: 25회/일, 500회/월
# 발급: https://www.alphavantage.co/support/#api-key
# ────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ────────────────────────────────────────────────────────────
# 뉴스 데이터 — Financial Modeling Prep (FMP)
# 용도: 종목별 관련 뉴스 (영문 중심)
# 무료 한도: 250회/일
# 발급: https://financialmodelingprep.com/developer/docs
# ────────────────────────────────────────────────────────────
FMP_API_KEY=your_fmp_api_key_here

# ────────────────────────────────────────────────────────────
# AI 분석 — Anthropic Claude API
# 용도: 종목 전망 분석 (스트리밍), 뉴스 감성분석 (배치)
# 과금: 토큰 사용량 기반 (claude-sonnet-4-20250514 권장)
# 발급: https://console.anthropic.com/
# ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ────────────────────────────────────────────────────────────
# 앱 설정
# ────────────────────────────────────────────────────────────

# 개발/프로덕션 환경 구분 (next.js 기본 제공이지만 명시적으로 설정)
NODE_ENV=development

# API 캐시 TTL 설정 (초 단위)
CACHE_TTL_QUOTE=60          # 현재가: 1분
CACHE_TTL_CHART=3600        # 차트 데이터: 1시간
CACHE_TTL_INDICATORS=3600   # 기술적 지표: 1시간
CACHE_TTL_NEWS=1800         # 뉴스: 30분

# Claude 모델 설정
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=2048

# 뉴스 감성분석 배치 크기 (기본 10건)
NEWS_SENTIMENT_BATCH_SIZE=10
